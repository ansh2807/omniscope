  <div class="card"><div class="lbl">Confidence</div><div class="big">{{ (pr.confidence * 100)|round|int }}<span style="font-size:.5em">%</span></div>
    <div class="sm">{{ pr.observations }} observation(s)</div></div>
  <div class="card"><div class="lbl">Content freshness</div><div class="big" style="font-size:1.35rem">{{ pr.freshness }}</div>
    {% if pr.days_since_dated_content is not none %}<div class="sm">{{ pr.days_since_dated_content }} days since dated page</div>{% endif %}</div>
</div>
<p>{{ pr.outlook }}</p>
{% if pr.tech_added or pr.tech_removed %}
<p class="src">{% if pr.tech_added %}Added: {{ pr.tech_added|join(', ') }}. {% endif %}{% if pr.tech_removed %}Removed: {{ pr.tech_removed|join(', ') }}.{% endif %}</p>
{% endif %}
<p class="src">{{ pr.methodology }}</p>
{% else %}
<p>No prior snapshot and no dated content were available for an outlook. <span class="chip una">unavailable</span></p>
{% endif %}
</section>

<section id="reason">
<h2>14 · Critique and synthesis</h2>
{% set rs = w.reasoning %}
{% if rs %}
<p class="src">{{ rs.methodology }}</p>
{% if rs.findings %}
<ul>{% for f in rs.findings %}<li>{{ f }}</li>{% endfor %}</ul>
{% endif %}
{% if rs.critiques %}
<p><b>Limits</b></p>
<ul>{% for c in rs.critiques %}<li>{{ c }}</li>{% endfor %}</ul>
{% endif %}
{% if rs.recommendations %}
<p><b>Recommended next actions</b> (from measured gaps only)</p>
<ul>{% for r in rs.recommendations %}<li>{{ r }}</li>{% endfor %}</ul>
{% endif %}
{% else %}
<p>No synthesis was attached to this report.</p>
{% endif %}
</section>

<section id="opps">
<h2>15 · Opportunities</h2>
{% if w.opportunities %}
{% for o in w.opportunities %}
<div class="call opportunity"><b>{{ o.title }}</b><p>{{ o.why }}</p>
<p class="src">Evidence: {{ o.evidence }}</p></div>
{% endfor %}
{% else %}
<p>No rule-driven opportunities fired on this sample — the measured fundamentals are
in place.</p>
{% endif %}
</section>

<section id="unmeasured">
<h2>16 · Not measured, and why</h2>
<table><thead><tr><th>Item</th><th>Why it is not in this report</th></tr></thead><tbody>
{% for u in w.unavailable %}
<tr><td>{{ u.item }}</td><td class="src">{{ u.why }}</td></tr>
{% endfor %}
</tbody></table>
<p class="src">OMNISCOPE never substitutes an estimate for a number that requires data
it does not have. <span class="chip una">unavailable</span> is a valid answer.</p>
</section>

<section id="evidence">
<h2>17 · Evidence</h2>
<div class="tw"><table><thead>
<tr><th>Claim supported</th><th>Source</th><th>Method</th><th>Collected</th><th>SHA-256</th></tr>
</thead><tbody>
{% for e in w.evidence.records %}
<tr>
  <td>{{ e.claim }}</td>
  <td class="src">{{ e.source_url|truncate(56) }}</td>
  <td>{{ e.method }}{{ ' (cache)' if e.from_cache }}</td>
  <td class="src">{{ e.collected_at|truncate(19, True, '') }}</td>
  <td class="src">{{ e.content_sha256[:12] if e.content_sha256 else '—' }}</td>
</tr>
{% endfor %}
</tbody></table></div>
</section>

<footer>{{ w.entity_name }} · generated {{ w.generated_at.strftime('%d %b %Y') }} ·
OMNISCOPE web engine v{{ w.engine_version }}. Figures drift; re-generate before acting.</footer>
</main>
</body></html>
