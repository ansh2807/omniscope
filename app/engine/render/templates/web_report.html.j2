<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta property="og:title" content="Website Intelligence — {{ w.entity_name }}">
<meta property="og:description" content="{{ w.tagline|e }}">
<meta property="og:type" content="article">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%233dd68c'/%3E%3Ctext x='16' y='22' font-family='sans-serif' font-size='14' font-weight='800' fill='%2304140c' text-anchor='middle'%3EOS%3C/text%3E%3C/svg%3E">
<title>Website Intelligence — {{ w.entity_name }}</title>
{% include "_style.html.j2" %}
</head><body>
<a class="skip" href="#main">Skip to report</a>
<nav><div class="nv">
<a href="#desk">0 Desk</a><a href="#score">1 Score</a><a href="#entity">2 Entity</a><a href="#tech">3 Technology</a>
<a href="#seo">4 SEO &amp; structure</a><a href="#social">5 Social presence</a>
<a href="#products">6 Product</a><a href="#reviews">7 Reviews</a>
<a href="#awards">8 Awards</a>
<a href="#competitors">9 Competitors</a><a href="#market">10 Market</a>
<a href="#seomap">11 SEO map</a><a href="#news">12 News</a><a href="#risk">Risk</a>
<a href="#oracle">13 Outlook</a>
<a href="#reason">14 Critique</a>
<a href="#opps">15 Opportunities</a><a href="#unmeasured">16 Not measured</a>
<a href="#evidence">17 Evidence</a>
</div></nav>
<main id="main" class="wrap">
<div class="cover">
  <div class="kick">Website Intelligence Report · OMNISCOPE</div>
  <h1>{{ w.entity_name }}</h1>
  <div class="handle">{{ w.domain }}</div>
  {% if w.tagline %}<div class="one">{{ w.tagline }}</div>{% endif %}
  <div class="meta">Generated {{ w.generated_at.strftime('%d %B %Y, %H:%M UTC') }} ·
    web engine v{{ w.engine_version }} ·
    {{ w.pages|length }} pages sampled ·
    intelligence score <b style="color:var(--txt)">{{ w.overall_score }}</b>/100</div>
  {% if w.usage %}
  <div class="meta">This run: {{ w.usage.get('pages_sampled', w.pages|length) }} pages ·
    {{ w.usage.get('search_calls', 0) }} search call(s) ·
    {{ w.usage.get('robots_blocked', 0) }} robots-blocked ·
    {{ w.usage.get('http_failed', 0) }} failed fetch(es).
    Observed work only — not spend.</div>
  {% endif %}
</div>

{% for warning in w.warnings %}
<div class="call risk"><b>Caveat</b><p>{{ warning }}</p></div>
{% endfor %}

{% if w.desk %}
<section id="desk">
<h2>0 · Marketing desk</h2>
<p class="lede">{{ w.desk.one_liner }}</p>
<p class="note">{{ w.desk.methodology }}</p>
<div class="grid">
  <div class="card"><div class="lbl">This week's job</div><p>{{ w.desk.job }}</p></div>
  <div class="card"><div class="lbl">Posture</div><p>{{ w.desk.posture }}</p>
    <div class="sm"><span class="chip est">modelled from public fields</span></div></div>
</div>
{% if w.desk.narrative %}
<p class="lede">{{ w.desk.narrative }}</p>
<p class="note">Optional prose restated from the filled cells above. Numbers not already on this desk were rejected.</p>
{% endif %}
<h3>Eight basic marketing needs</h3>
<div class="grid">
{% for n in w.desk.needs %}
<div class="card">
  <div class="lbl">{{ n.title }}
    <span class="chip {{ 'obs' if n.status in ('observed','calculated') else ('una' if n.status=='unavailable' else 'est') }}">{{ n.status }}</span>
  </div>
  <p>{{ n.meaning }}</p>
  <p class="note">{{ n.evidence }}</p>
  <p><b>Next</b> {{ n.next_step }}</p>
</div>
{% endfor %}
</div>
{% if w.desk.frameworks %}
<h3>Frameworks filled from this site</h3>
{% for fw in w.desk.frameworks %}
<h4>{{ fw.name }}</h4>
<table>
<thead><tr><th>Slot</th><th>Fill</th><th></th></tr></thead>
<tbody>
{% for c in fw.cells %}
<tr>
  <td><b>{{ c.slot }}</b></td>
  <td>{{ c.fill }}{% if c.note %}<div class="note">{{ c.note }}</div>{% endif %}</td>
  <td><span class="chip {{ 'obs' if c.status in ('observed','calculated') else ('una' if c.status=='unavailable' else 'est') }}">{{ c.status }}</span></td>
</tr>
{% endfor %}
</tbody>
</table>
{% endfor %}
{% endif %}
{% if w.desk.playbooks %}
<h3>Playbooks from observed surfaces</h3>
<p class="note">A playbook appears only when a public file or path triggered it. It is a template, not a forecast.</p>
{% for pb in w.desk.playbooks %}
<div class="card">
  <div class="lbl">{{ pb.title }}
    <span class="chip {{ 'obs' if pb.status in ('observed','calculated') else ('una' if pb.status=='unavailable' else 'est') }}">{{ pb.status }}</span>
  </div>
  <p>{{ pb.why }}</p>
  <ul>{% for step in pb.steps %}<li>{{ step }}</li>{% endfor %}</ul>
  {% if pb.cannot %}<p class="note">{{ pb.cannot }}</p>{% endif %}
</div>
{% endfor %}
{% endif %}
{% if w.desk.week_plan %}
<h3>This week</h3>
<ul>{% for step in w.desk.week_plan %}<li>{{ step }}</li>{% endfor %}</ul>
{% endif %}
{% if w.desk.cannot_know %}
<p class="note"><b>Will not be invented:</b> {{ w.desk.cannot_know|join(' · ') }}</p>
{% endif %}
{% if w.desk.glossary %}
<h3>How to read the chips</h3>
<table>
<thead><tr><th>Term</th><th>Meaning</th></tr></thead>
<tbody>
{% for g in w.desk.glossary %}
<tr><td><b>{{ g.term }}</b></td><td>{{ g.meaning }}</td></tr>
{% endfor %}
</tbody>
</table>
{% endif %}
</section>
{% endif %}

<section id="score">
<h2>1 · Website intelligence score</h2>
<p>Every dimension below is computed only from what the site publicly serves; each card
prints its formula and inputs. What could not be measured is listed in
<a href="#unmeasured">Not measured</a> — it is never blended into a score.</p>
<div class="grid">
  <div class="card"><div class="lbl">Overall</div><div class="big">{{ w.overall_score }}</div>
    <div class="sm">mean of the six dimensions × 10 <span class="chip">calculated</span></div></div>
  {% for s in w.scores %}
  <div class="card">
    <div class="lbl">{{ s.label }}</div>
    <div class="big">{{ s.score }}<span style="font-size:.5em">/10</span></div>
    <div class="bar"><i style="width:{{ (s.score * 10)|round|int }}%"></i></div>
    <div class="formula">{{ s.formula }}</div>
  </div>
  {% endfor %}
</div>
</section>

<section id="entity">
<h2>2 · Entity overview</h2>
<table><tbody>
<tr><th>Entity</th><td>{{ w.entity_name }} <span class="chip obs">observed</span></td></tr>
<tr><th>Domain</th><td>{{ w.domain }}</td></tr>
<tr><th>Seed</th><td>{{ w.seed_url }}</td></tr>
{% if w.tagline %}<tr><th>Self-description</th><td>{{ w.tagline }}</td></tr>{% endif %}
{% if w.contacts.emails %}<tr><th>Public emails</th><td>{{ w.contacts.emails|join(', ') }}</td></tr>{% endif %}
{% if w.contacts.phones %}<tr><th>Public phones</th><td>{{ w.contacts.phones|join(', ') }}</td></tr>{% endif %}
<tr><th>Structured data</th><td>
  {% if w.seo.structured_data_types %}{{ w.seo.structured_data_types|join(', ') }}
  {% else %}none published{% endif %}</td></tr>
<tr><th>Latest dated content</th><td>{{ w.content.latest_dated_content or 'no dated content found in sample' }}</td></tr>
{% if w.content_dna and w.content_dna.assessed %}
<tr><th>Content DNA · hooks</th><td>{{ w.content_dna.hooks|join(' · ') or '—' }}</td></tr>
<tr><th>Content DNA · CTAs</th><td>{{ w.content_dna.ctas|join(', ') or 'none printed on sampled pages' }}</td></tr>
{% endif %}
</tbody></table>
<p class="src">Pages sampled:
{% for p in w.pages %}{{ p.url }}{{ " · " if not loop.last }}{% endfor %}</p>
</section>

<section id="tech">
<h2>3 · Technology (publicly observable)</h2>
{% if w.tech %}
<table><thead><tr><th>Category</th><th>Technology</th><th>Evidence</th></tr></thead><tbody>
{% for t in w.tech %}
<tr><td>{{ t.category }}</td><td>{{ t.name }}</td><td class="src">{{ t.evidence }}</td></tr>
{% endfor %}
</tbody></table>
{% else %}
<p>No known technology fingerprints matched on the sampled pages. This detects only
what pages serve to every visitor — server-side stacks are invisible by design.</p>
{% endif %}
</section>

<section id="seo">
<h2>4 · SEO &amp; structure</h2>
<div class="grid">
  <div class="card"><div class="lbl">robots.txt</div>
    <div class="big">{{ 'yes' if w.seo.robots_txt else 'no' }}</div></div>
  <div class="card"><div class="lbl">sitemap.xml</div>
    <div class="big">{{ 'yes' if w.seo.sitemap_xml else 'no' }}</div>
    {% if w.seo.sitemap_xml %}<div class="sm">{{ w.seo.sitemap_url_count }} URLs listed</div>{% endif %}</div>
  <div class="card"><div class="lbl">Words sampled</div>
    <div class="big">{{ '{:,}'.format(w.content.total_words) }}</div>
    <div class="sm">across {{ w.content.pages_sampled }} pages</div></div>
</div>
<div class="tw"><table><thead>
<tr><th>Page</th><th>Title</th><th>Meta description</th><th>H1</th><th>Words</th><th>Schema</th></tr>
</thead><tbody>
{% for p in w.pages %}
<tr>
  <td class="src">{{ p.url|replace('https://','')|replace('http://','')|truncate(48) }}</td>
  <td>{{ p.title|truncate(60) if p.title else '—' }}</td>
  <td>{{ '✓' if p.meta_description else '—' }}</td>
  <td>{{ '✓' if p.h1 else '—' }}</td>
  <td>{{ '{:,}'.format(p.word_count) }}</td>
  <td>{{ p.jsonld_types|join(', ')|truncate(40) if p.jsonld_types else '—' }}</td>
</tr>
{% endfor %}
</tbody></table></div>
<p class="src">Rankings, search demand, traffic and backlinks are not measured here —
they need a search/keyword provider and are listed under Not measured.</p>
</section>

<section id="social">
<h2>5 · Social presence</h2>
{% if w.socials %}
<table><thead><tr><th>Platform</th><th>Account</th><th>Followers</th><th>Status</th></tr></thead><tbody>
{% for s in w.socials %}
<tr>
  <td>{{ s.platform }}</td>
  <td>{{ s.display_name or s.handle or s.url|truncate(50) }}</td>
  <td>{% if s.followers %}{{ '{:,}'.format(s.followers) }} <span class="chip obs">observed</span>
      {% else %}<span class="chip una">unavailable</span>{% endif %}</td>
  <td class="src">{{ s.error or ('verified' if s.verified else 'linked from website, collected live') }}</td>
</tr>
{% endfor %}
</tbody></table>
<p class="src">Accounts were discovered from the site's own links and sameAs metadata,
then collected live by the platform collectors. For a full creator-grade analysis of
any account, run it as its own investigation.</p>
{% else %}
<p>No social account could be discovered from the website's own links or structured
metadata. <span class="chip una">unavailable</span></p>
{% endif %}
</section>

<section id="products">
<h2>6 · Product intelligence</h2>
{% set pi = w.product_intel %}
{% if pi and pi.assessed %}
<div class="grid">
  <div class="card"><div class="lbl">Pricing model</div><div class="big" style="font-size:1.4rem">{{ pi.pricing_model }}</div></div>
  <div class="card"><div class="lbl">Public offers</div><div class="big">{{ pi.offer_count }}</div></div>
  <div class="card"><div class="lbl">INR ladder</div>
    <div class="big" style="font-size:1.15rem">{% if pi.price_floor is not none %}₹{{ '{:,.0f}'.format(pi.price_floor) }}–₹{{ '{:,.0f}'.format(pi.price_ceiling) }}{% else %}—{% endif %}</div></div>
</div>
{% if pi.positioning %}<p>{{ pi.positioning }}</p>{% endif %}
{% if pi.ladder %}
<table><thead><tr><th>Offer</th><th>Kind</th><th>Price (INR)</th><th>Availability</th><th>Valid until</th></tr></thead><tbody>
{% for pr in pi.ladder %}
<tr><td>{{ pr.name }}</td><td>{{ pr.kind }}</td>
<td>{% if pr.price_inr %}₹{{ '{:,.0f}'.format(pr.price_inr) }}{% else %}—{% endif %}</td>
<td class="src">{{ pr.availability or '—' }}</td>
<td class="src">{{ pr.valid_until or '—' }}</td></tr>
{% endfor %}
</tbody></table>
{% endif %}
{% if pi.visible_prices %}
<p><b>Visible ₹ lines</b> near commercial words. These are not SKUs:</p>
<table><thead><tr><th>Amount</th><th>Excerpt</th></tr></thead><tbody>
{% for vp in pi.visible_prices %}
<tr><td>₹{{ '{:,.0f}'.format(vp.amount) }}</td><td class="src">{{ vp.excerpt|truncate(120) }}</td></tr>
{% endfor %}
</tbody></table>
{% endif %}
{% if pi.catalog %}
<p><b>Printed catalog identifiers</b> from Product schema. Visible ₹ lines are not SKUs:</p>
<table><thead><tr><th>Kind</th><th>Offer</th><th>Value</th></tr></thead><tbody>
{% for idn in pi.catalog %}
<tr><td>{{ idn.kind }}</td><td>{{ idn.name or '—' }}</td><td class="src">{{ idn.value }}</td></tr>
{% endfor %}
</tbody></table>
{% endif %}
{% if pi.policies %}
<p><b>Printed return / shipping terms</b> from Offer schema. Not a delivery-time model:</p>
<table><thead><tr><th>Kind</th><th>Offer</th><th>Printed fields</th></tr></thead><tbody>
{% for pol in pi.policies %}
<tr><td>{{ pol.kind }}</td><td>{{ pol.name or '—' }}</td><td class="src">{{ pol.detail }}</td></tr>
{% endfor %}
</tbody></table>
{% endif %}
{% if pi.gaps %}
{% for g in pi.gaps %}<div class="call"><b>Gap</b><p>{{ g }}</p></div>{% endfor %}
{% endif %}
<p class="src">{{ pi.methodology }}</p>
{% elif pi %}
<p>{{ pi.reason_not_assessed }} <span class="chip una">unavailable</span></p>
<p class="src">{{ pi.methodology }}</p>
{% else %}
<p>Product intelligence was not run on this report.</p>
{% endif %}
</section>

<section id="reviews">
<h2>7 · Reviews</h2>
{% set ri = w.review_intel %}
{% if ri and ri.assessed %}
{% if ri.ratings %}
<p><b>Printed AggregateRating</b> — schema stars, not a verified review volume:</p>
<table><thead><tr><th>Name</th><th>Value</th><th>Count</th><th>Via</th></tr></thead><tbody>
{% for c in ri.ratings %}
<tr><td>{{ c.name or '—' }}</td>
<td class="mono">{{ c.value or '—' }}{% if c.best %} / {{ c.best }}{% endif %}</td>
<td class="src">{{ c.count or '—' }}</td>
<td class="src">{{ c.via or '—' }}</td></tr>
{% endfor %}
</tbody></table>
{% elif ri.aggregate_rating is not none %}
<p>Published aggregate rating <b>{{ ri.aggregate_rating }}</b>
{% if ri.aggregate_count %} across {{ ri.aggregate_count }} ratings{% endif %}
<span class="chip obs">observed</span></p>
{% endif %}
{% if ri.themes %}
<p class="src">{% for k, v in ri.themes.items() %}{{ k }} {{ v }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% endif %}
{% if ri.items %}
<table><thead><tr><th>Theme</th><th>Review</th><th>Rating</th></tr></thead><tbody>
{% for it in ri.items %}
<tr>
  <td class="src">{{ it.themes|join(', ') or '—' }}</td>
  <td>{{ it.body|truncate(180) }}</td>
  <td class="mono">{{ it.rating if it.rating is not none else '—' }}</td>
</tr>
{% endfor %}
</tbody></table>
{% elif ri.reason %}<p class="src">{{ ri.reason }}</p>{% endif %}
<p class="src">{{ ri.methodology }}</p>
{% elif ri %}
<p>{{ ri.reason }} <span class="chip una">unavailable</span></p>
{% else %}
<p>Review intelligence was not run. <span class="chip una">unavailable</span></p>
{% endif %}
</section>

<section id="awards">
<h2>8 · Award intelligence</h2>
{% set ai = w.award_intel %}
{% if ai and ai.mentions %}
<table><thead><tr><th>Award</th><th>Status</th><th>Evidence</th></tr></thead><tbody>
{% for m in ai.mentions %}
<tr>
  <td>{{ m.award }}</td>
  <td><span class="chip {{ 'est' if m.status == 'self_claimed' else 'obs' }}">{{ m.status }}</span></td>
  <td class="src">{{ m.excerpt }} · {{ m.source_url|truncate(48) }}</td>
</tr>
{% endfor %}
</tbody></table>
{% elif ai and ai.reason %}
<p>{{ ai.reason }} <span class="chip una">unavailable</span></p>
{% endif %}
{% if ai and ai.generic_claims %}
<p class="src">Generic award language on-site:
{% for g in ai.generic_claims %}“{{ g }}”{% if not loop.last %}; {% endif %}{% endfor %}</p>
{% endif %}
{% if ai and ai.calendar %}
<h3 style="font-size:1rem;margin:22px 0 10px">Known award calendar (typical season)</h3>
<table><thead><tr><th>Award</th><th>Season</th><th>Region</th><th>On this site</th></tr></thead><tbody>
{% for c in ai.calendar %}
<tr>
  <td>{{ c.name }}</td>
  <td>{{ c.season }}</td>
  <td>{{ c.region }}</td>
  <td>{% if c.mentioned_on_site %}<span class="chip obs">mentioned</span>{% else %}—{% endif %}</td>
</tr>
{% endfor %}
</tbody></table>
{% endif %}
{% if ai %}<p class="src">{{ ai.methodology }}</p>{% endif %}
</section>

<section id="competitors">
<h2>9 · Competitors</h2>
{% set ci = w.competitor_intel %}
{% if ci and ci.assessed and ci.competitors %}
<p>Official websites that ranked for <b>{{ ci.query_used }}</b>. Shared customers and
market share were not measured.</p>
<table><thead><tr><th>Entity</th><th>Domain</th><th>Why it surfaced</th></tr></thead><tbody>
{% for c in ci.competitors %}
<tr>
  <td>{{ c.name }}</td>
  <td class="src">{{ c.domain }}</td>
  <td class="src">{{ c.snippet or c.found_via }}</td>
</tr>
{% endfor %}
</tbody></table>
<p class="src">{{ ci.methodology }}</p>
{% elif ci %}
<p>{{ ci.reason }} <span class="chip una">unavailable</span></p>
<p class="src">{{ ci.methodology }}</p>
{% else %}
<p>Competitor discovery was not run on this report. <span class="chip una">unavailable</span></p>
{% endif %}
</section>

<section id="market">
<h2>10 · Market map</h2>
{% set mi = w.market_intel %}
{% if mi and mi.assessed and mi.participants %}
<p>Official websites that ranked for <b>{{ mi.query_used }}</b>. Not a census and not market share.</p>
<table><thead><tr><th>Participant</th><th>Domain</th><th>Snippet</th></tr></thead><tbody>
{% for p in mi.participants %}
<tr><td>{{ p.name }}</td><td class="src">{{ p.domain }}</td><td class="src">{{ p.snippet|truncate(140) }}</td></tr>
{% endfor %}
</tbody></table>
<p class="src">{{ mi.methodology }}</p>
{% elif mi %}
<p>{{ mi.reason }} <span class="chip una">unavailable</span></p>
{% else %}
<p>Market map was not run. <span class="chip una">unavailable</span></p>
{% endif %}
</section>

<section id="seomap">
<h2>11 · SEO coverage map</h2>
{% set sm = w.seo_map %}
{% if sm and sm.slots %}
<p>Expected commercial paths vs this crawl. This is <b>not</b> a demand × competition keyword map.</p>
<table><thead><tr><th>Slot</th><th>Status</th><th>Evidence</th></tr></thead><tbody>
{% for s in sm.slots %}
<tr>
  <td>{{ s.slot }} <span class="src">{{ s.intent }}</span></td>
  <td><span class="chip {{ 'obs' if s.status == 'present' else ('est' if s.status == 'thin' else 'una') }}">{{ s.status }}</span></td>
  <td class="src">{{ s.url or s.evidence }}</td>
</tr>
{% endfor %}
</tbody></table>
{% if sm.topics %}<p class="src">On-page topics: {{ sm.topics|join(' · ') }}</p>{% endif %}
{% if sm.canonical_conflicts %}
<p class="src">Canonical host mismatch: {{ sm.canonical_conflicts|join(' · ') }}</p>
{% endif %}
<p class="src">{{ sm.methodology }}</p>
{% else %}
<p>Coverage map was not run. <span class="chip una">unavailable</span></p>
{% endif %}
</section>

<section id="site">
<h2>Site signals</h2>
{% set rb = w.robots_intel %}
{% if rb and rb.assessed %}
<p>robots.txt published {{ rb.disallow|length }} disallow path(s)
{% if rb.crawl_delay %} · crawl-delay {{ rb.crawl_delay }}{% endif %}.</p>
{% elif rb %}
<p>{{ rb.reason }} <span class="chip una">unavailable</span></p>
{% endif %}
{% set hd = w.header_intel %}
{% if hd and hd.assessed %}
<p>Security headers present: {{ hd.present.keys()|list|join(', ') or 'none of the six we record' }}.
Missing: {{ hd.missing|join(', ') or '—' }}.</p>
{% if hd.last_modified or hd.etag or hd.cache_control or hd.x_robots_tag %}
<p>Freshness headers:
{% if hd.last_modified %} Last-Modified {{ hd.last_modified }}{% endif %}
{% if hd.etag %} · ETag {{ hd.etag|truncate(40) }}{% endif %}
{% if hd.cache_control %} · Cache-Control {{ hd.cache_control }}{% endif %}
{% if hd.x_robots_tag %} · X-Robots-Tag {{ hd.x_robots_tag }}{% endif %}.
Last-Modified is the header, not a verified edit.</p>
{% endif %}
{% if hd.csp_hosts %}
<p><b>CSP host tokens</b> — policy, not a live load list or vendor contract:
{{ hd.csp_hosts|join(', ') }}.</p>
{% endif %}
<p class="src">{{ hd.methodology }}</p>
{% endif %}
{% set ix = w.index_intel %}
{% if ix and ix.assessed and ix.pages %}
<p><b>Indexability directives</b> — copied tokens, not a ranking claim.
{% if ix.noindex %} {{ ix.noindex|length }} sampled page(s) printed noindex.{% endif %}</p>
<table><thead><tr><th>URL</th><th>Source</th><th>Tokens</th></tr></thead><tbody>
{% for p in ix.pages %}
<tr><td class="src">{{ p.url|truncate(60) }}</td><td>{{ p.source }}</td>
<td class="src">{{ p.tokens|join(', ') or p.raw }}</td></tr>
{% endfor %}
</tbody></table>
<p class="src">{{ ix.methodology }}</p>
{% elif ix and ix.assessed %}
<p class="src">{{ ix.reason }}</p>
{% endif %}
{% set pf = w.public_intel %}
{% if pf and pf.files %}
<p><b>Well-known inventory</b> — published trust / AI / people / ads / privacy files. Not a security score and not traffic.</p>
<table><thead><tr><th>Path</th><th>Role</th><th>Status</th><th>Notes</th></tr></thead><tbody>
{% for f in pf.files %}
<tr>
  <td class="src">{{ f.path }}</td>
  <td>{{ f.role or '—' }}</td>
  <td>{{ 'present' if f.present else 'absent' }}</td>
