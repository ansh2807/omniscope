<div class="lede">{{ br.perception }}</div>
<div class="grid g4">
{% for pil in br.pillars %}
  <div class="card"><div class="lbl">{{ pil.name }}</div><div class="big">{{ pil.score }}<span style="font-size:15px;color:var(--dim)">/10</span></div><div class="sm">{{ pil.grade }}</div></div>
{% endfor %}
</div>
<div class="tw"><table><thead><tr><th style="width:16%">Pillar</th><th style="width:8%">Score</th><th style="width:30%">Evidence</th><th>Reading</th></tr></thead><tbody>
{% for pil in br.pillars %}<tr><td><b>{{ pil.name }}</b></td><td class="n">{{ pil.score }}/10</td>
<td>{{ pil.evidence|join('; ') if pil.evidence else '—' }}</td><td>{{ pil.why }}</td></tr>{% endfor %}
</tbody></table></div>
<div class="grid g2">
  <div class="card"><h4>Brand promise</h4><p class="sm">{{ br.promise }}</p>
    <h4>Proof points</h4><ul class="t">{% for pr in br.proof %}<li>{{ pr }}</li>{% endfor %}</ul></div>
  <div class="card"><h4>Brand personality</h4>
    {% for tr in br.personality %}<div class="rw" style="display:flex;justify-content:space-between;font-size:12.5px;margin-top:10px"><span>{{ tr.trait }}</span><span style="color:var(--mut)">{{ tr.share }}%</span></div><div class="bar"><i style="width:{{ tr.share }}%"></i></div>{% endfor %}
    <h4 style="margin-top:18px">Brand voice</h4>
    {% for v in br.voice %}<div style="font-size:12.5px;margin-top:8px">{{ v.axis }} — reads <b>{{ v.reads }}</b></div><div class="bar"><i style="width:{{ v.position }}%"></i></div>{% endfor %}
  </div>
</div>
<h3>SWOT</h3>
<div class="grid g2">
  <div class="card" style="border-top:3px solid var(--good)"><h4 style="color:var(--good)">Strengths</h4><ul class="t">{% for x in br.swot.strengths %}<li>{{ x }}</li>{% endfor %}</ul></div>
  <div class="card" style="border-top:3px solid var(--bad)"><h4 style="color:var(--bad)">Weaknesses</h4><ul class="t">{% for x in br.swot.weaknesses %}<li>{{ x }}</li>{% endfor %}</ul></div>
  <div class="card" style="border-top:3px solid var(--acc)"><h4 style="color:var(--acc)">Opportunities</h4><ul class="t">{% for x in br.swot.opportunities %}<li>{{ x }}</li>{% endfor %}</ul></div>
  <div class="card" style="border-top:3px solid var(--warn)"><h4 style="color:var(--warn)">Threats</h4><ul class="t">{% for x in br.swot.threats %}<li>{{ x }}</li>{% endfor %}</ul></div>
</div>
<h3>Brand positioning map</h3>
<div class="chartbox"><p class="cap">{{ br.position_note }}</p><div class="cw t"><canvas id="{{ pre }}cPos"></canvas></div></div>
<p class="src">{{ br.consistency }}</p>
</section>

<section id="{{ pre }}growth2">
<h2>12 — Growth Analysis</h2>
{% if gr.measurable %}
<div class="lede">{{ gr.trend_note }}</div>
<div class="chartbox"><p class="cap">Growth timeline — median views per item by quarter <span class="chip obs">OBSERVED</span></p><div class="cw"><canvas id="{{ pre }}cGrowth"></canvas></div></div>
<div class="tw"><table><thead><tr><th style="width:12%">Era</th><th>Window</th><th>Items</th><th>Median views</th><th>Median length</th><th>Dominant topics</th></tr></thead><tbody>
