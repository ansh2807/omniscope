<td>{{ e.top_topics|join(', ') }}</td></tr>{% endfor %}
</tbody></table></div>
{% if gr.content_evolution %}<div class="call"><b>Content evolution</b><p>{{ gr.content_evolution }}</p></div>{% endif %}
{% if gr.audience_evolution %}<div class="call"><b>Audience evolution</b><p>{{ gr.audience_evolution }}</p></div>{% endif %}
{% if gr.brand_evolution %}<div class="call"><b>Brand evolution</b><p>{{ gr.brand_evolution }}</p></div>{% endif %}
{% else %}
