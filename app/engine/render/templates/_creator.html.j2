</tbody></table></div>{% endif %}
{% if gr.missed %}<h3>Missed opportunities</h3>
<ul class="t">{% for m in gr.missed %}<li><b>{{ m.missed }}.</b> {{ m.evidence }}</li>{% endfor %}</ul>{% endif %}
{% if gr.future %}<h3>Future plays</h3>
<div class="tw"><table><thead><tr><th style="width:34%">Play</th><th>Why now</th></tr></thead><tbody>
{% for fu in gr.future %}<tr><td><b>{{ fu.play }}</b></td><td>{{ fu.why }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
</section>

<section id="{{ pre }}funnel">
<h2>13 — Marketing Funnel Assessment</h2>
<div class="lede">Public offer and routing evidence. Conversion, revenue and retention remain unavailable without first-party data.</div>
<div class="grid g4">
  <div class="card"><div class="lbl">Funnel score</div><div class="big">{{ f.total }}<span style="font-size:16px;color:var(--dim)">/70</span></div><div class="sm">seven dimensions</div></div>
  <div class="card"><div class="lbl">Price ladder</div><div class="big">{{ f.rungs|length }}</div><div class="sm">{% if f.spread %}{{ f.spread }}× spread, ₹{{ "{:,.0f}".format(f.price_min) }}–₹{{ "{:,.0f}".format(f.price_max) }}{% else %}no public pricing{% endif %}</div></div>
  <div class="card"><div class="lbl">Permissioned channels</div><div class="big">{{ f.permissioned_channels|length }}</div><div class="sm">{{ f.permissioned_channels|join(', ') or 'none observed' }}</div></div>
  <div class="card"><div class="lbl">Verified first-party list</div><div class="big">{{ 'yes' if f.owned_audience else 'not observed' }}</div><div class="sm">{{ f.owned_audience_note }}</div></div>
</div>
{% if dx %}
<h3>Offer architecture and routing diagnostics <span class="chip obs">CALCULATED</span></h3>
<div class="grid g4">
  <div class="card"><div class="lbl">Observed SKUs</div><div class="big">{{ dx.sku_count }}</div><div class="sm">{{ dx.priced_sku_count }} with public price</div></div>
  <div class="card"><div class="lbl">Log price span</div><div class="big">{{ dx.log_price_span if dx.log_price_span is not none else '—' }}</div><div class="sm">log10(max/min), not willingness to pay</div></div>
  <div class="card"><div class="lbl">Largest adjacent step</div><div class="big">{{ (dx.max_adjacent_price_gap|string ~ '×') if dx.max_adjacent_price_gap is not none else '—' }}</div><div class="sm">largest gap between sorted public prices</div></div>
  <div class="card"><div class="lbl">Routing evidence coverage</div><div class="big">{{ dx.route_readiness }}<span style="font-size:15px;color:var(--dim)">/100</span></div><div class="sm">visible infrastructure only</div></div>
</div>
{% if p.funnel.rungs %}<div class="chartbox"><p class="cap">Observed price ladder. Architecture only; sales distribution unavailable.</p><div class="cw"><canvas id="{{ pre }}cPrices"></canvas></div></div>{% endif %}
<div class="tw"><table><thead><tr><th>Infrastructure component</th><th>Observed</th><th>Coverage weight</th><th>Interpretation</th></tr></thead><tbody>
{% for x in dx.route_components %}<tr><td><b>{{ x.component }}</b></td><td><span class="chip {{ 'obs' if x.observed else 'una' }}">{{ 'YES' if x.observed else 'NO' }}</span></td><td class="n">{{ x.weight }}</td><td>{{ 'Public evidence found.' if x.observed else 'Not observed; absence from public surfaces is not proof it does not exist.' }}</td></tr>{% endfor %}
</tbody></table></div>
<p class="src">{{ dx.offer_read }}</p>
{% endif %}
<div class="fun">
{% for st in f.stages %}<div class="fst" style="width:{{ st.width }}%"><b>{{ st.stage }}</b><span>{{ st.detail }}</span></div>{% endfor %}
</div>
<p class="note">Stage widths are illustrative layout only; they are not conversion rates or measured drop-off.</p>
{% if f.rungs %}
<h3>Observed price ladder <span class="chip obs">OBSERVED</span></h3>
<div class="tw"><table><thead><tr><th style="width:14%">Tier</th><th>Product</th><th>Price</th></tr></thead><tbody>
{% for r in f.rungs %}<tr><td>{{ r.tier.replace('_',' ') }}</td><td>{{ r.name }}</td><td class="n">₹{{ "{:,.0f}".format(r.price_inr) }}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
<h3>Evidence-coverage rubric</h3>
<div class="chartbox"><div class="cw t"><canvas id="{{ pre }}cFun"></canvas></div></div>
<div class="tw"><table><thead><tr><th style="width:20%">Dimension</th><th style="width:8%">Score</th><th>Reasoning</th></tr></thead><tbody>
{% for sc in f.scores %}<tr><td><b>{{ sc.dimension }}</b></td><td class="n">{{ sc.value }}/10</td><td>{{ sc.why }}</td></tr>{% endfor %}
</tbody></table></div>
<div class="call opportunity"><b>Strongest</b><p>{{ f.strength }}</p></div>
<div class="call risk"><b>Weakest</b><p>{{ f.gap }}</p></div>
</section>

<section id="{{ pre }}personas">
<h2>14 — Audience Personas</h2>
<div class="lede">{{ a.personas|length }} activation hypotheses derived from content needs—not measured audience segments. Validate them in comments, surveys or first-party analytics before targeting.</div>
<div class="grid g3">
{% for pe in a.personas %}
<div class="pers"><div class="pn">{{ pe.name }}</div><div class="pt">{{ pe.tag }}</div><div class="src">{{ pe.basis }} · confidence {{ (pe.confidence*100)|round|int }}%</div><dl>
<dt>Goal</dt><dd>{{ pe.goal }}</dd><dt>Pain</dt><dd>{{ pe.pain }}</dd><dt>Watches</dt><dd>{{ pe.watches }}</dd>
<dt>Buys</dt><dd>{{ pe.buys }}</dd><dt>Also on</dt><dd>{{ pe.also_on }}</dd><dt>Reach them with</dt><dd>{{ pe.reach_with }}</dd>
</dl></div>{% endfor %}
</div>
</section>

<section id="{{ pre }}growth">
<h2>15 — Growth Opportunities</h2>
<div class="lede">Test ideas tied to specific observations. Impact remains unvalidated until a controlled test or first-party result exists.</div>
{% if p.opportunities %}
<div class="tw"><table><thead><tr><th style="width:12%">Area</th><th>Opportunity</th><th style="width:10%">Effort</th><th style="width:11%">Impact</th></tr></thead><tbody>
{% for o in p.opportunities %}<tr><td><b>{{ o.area }}</b></td><td>{{ o.what }}</td><td>{{ o.effort }}</td>
<td><span class="pill {{ 'hi' if 'Very high' in o.impact else '' }}">{{ o.impact }}</span></td></tr>{% endfor %}
</tbody></table></div>
{% else %}<p class="note">No opportunity rule fired for this subject.</p>{% endif %}
</section>

<section id="{{ pre }}recs">
<h2>16 — Strategic Recommendations</h2>
<div class="lede">Split by who is reading this.</div>
<div class="tw"><table><thead><tr><th style="width:12%">Priority</th><th style="width:20%">Who</th><th style="width:26%">Do this</th><th>Because</th></tr></thead><tbody>
{% for r in p.recommendations %}<tr><td><span class="pill {{ 'lo' if r.priority == 'Critical' else '' }}">{{ r.priority }}</span></td><td>{{ r.who }}</td><td><b>{{ r.what }}</b></td><td>{{ r.why }}</td></tr>{% endfor %}
</tbody></table></div>
<h3>Activation summary</h3>
<div class="tw"><table><thead><tr><th style="width:28%">If you are…</th><th>Then</th></tr></thead><tbody>
{% for act in a.activation %}<tr><td><b>{{ act.who }}</b></td><td>{{ act.do }}</td></tr>{% endfor %}
</tbody></table></div>
{% if dx %}
<h3>Decision-gate validation register</h3>
<p class="note">These are the missing inputs that can materially change a brand, product or investment decision. They are prioritised above cosmetic extra data.</p>
<div class="tw"><table><thead><tr><th style="width:24%">Blocked decision dimension</th><th>Why current evidence is insufficient</th><th>Required next evidence</th></tr></thead><tbody>
{% for e in dx.evidence_dimensions if e.status in ('unavailable','modelled') %}<tr><td><b>{{ e.dimension }}</b></td><td>{{ e.evidence }}</td><td>{{ e.unlock }}</td></tr>{% endfor %}
</tbody></table></div>
{% endif %}
</section>
