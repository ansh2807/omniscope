# ============================================================================
# PRODUCTION — see LAUNCH.md before going live
# ============================================================================
DOMAIN="reports.yourdomain.com"
POSTGRES_PASSWORD=""            # generate: openssl rand -base64 32

# Deployment mode: saas (you host it) | selfhost (customer hosts it)
DEPLOYMENT_MODE="saas"
APP_VERSION="8.23.0"

# Admin panel. Separate from customer keys. Leave blank to disable /admin entirely.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=""

SIGNUP_OPEN=false
PUBLIC_EMAIL_MODE=true
FREE_UNTIL=
PAID_ENFORCED=false

# Email delivery (no customer accounts). Leave SMTP_HOST blank to skip sending.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE=true

# Optional desk prose. Leave empty — the desk still works.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# 0 = manual sweep only. Production overnight: 720 (12 hours).
WATCH_INTERVAL_MINUTES=0
TRIAL_DAYS=7
TRIAL_REPORTS=3

# ---------- billing (Razorpay) ----------
# Dashboard -> Settings -> API Keys, and Settings -> Webhooks for the secret.
# Webhook URL:  https://your-domain/billing/webhook
# Events: subscription.activated, .charged, .halted, .cancelled, .paused,
#         .resumed, .pending, .completed, payment.failed
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- self-hosted instances only ----------
# A customer's own install points these at your server to validate its licence.
LICENSE_SERVER_URL=""
LICENSE_KEY=""
LICENSE_GRACE_DAYS=14
UPDATE_CHANNEL="stable"

# ---------- core ----------
APP_NAME="OMNISCOPE"
DATABASE_URL="sqlite:///./data/creatorintel.db"
REPORTS_DIR="./data/reports"
CACHE_DIR="./data/cache"
PUBLIC_BASE_URL="http://localhost:8000"

# Comma-separated keys accepted by the API and the web UI.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS="dev-key-change-me"

# ---------- politeness / safety ----------
USER_AGENT="CreatorIntelBot/1.0 (+https://your-domain.example/bot)"
REQUEST_TIMEOUT=20
MAX_CONCURRENCY=4
PER_HOST_DELAY=1.5
RESPECT_ROBOTS=true
CACHE_TTL_HOURS=24

# ---------- storage hygiene ----------
# Each report is deleted from the website after REPORT_TTL_MINUTES.
# RETENTION_DAYS is only used when REPORT_TTL_MINUTES is 0.
REPORT_TTL_MINUTES=1440
RETENTION_DAYS=0
MAX_REPORTS=200
MAX_CACHE_MB=500

# ---------- browser tier ----------
# Renders public pages in a real browser, logged out, exactly as a visitor sees them.
# This is what lets the engine read Instagram follower counts, YouTube "Popular" view
# counts and YouTube comment threads WITHOUT any API key.
#   off    - never use a browser (HTTP + official APIs only)
#   auto   - use the browser only when the cheaper tiers came back empty  (recommended)
#   always - use the browser first for Instagram and YouTube
# Requires: pip install playwright && python -m playwright install chromium
BROWSER_MODE="auto"
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_USER_AGENT=""
BROWSER_MAX_COMMENT_VIDEOS=6

# ---------- data sources (all optional; the engine degrades gracefully) ----------
# YouTube Data API v3. Free 10,000 units/day. Strongly recommended.
YOUTUBE_API_KEY=""

# Discovery/dork layer: serper | brave | google_cse | all | none.
# When ensemble mode is on, the selected provider is queried with every other
# configured provider and Titan retains provider consensus per canonical URL.
SEARCH_PROVIDER="none"
SEARCH_ENSEMBLE=true
SEARCH_MAX_PROVIDERS=3
DISCOVERY_QUERY_BUDGET=36
DISCOVERY_CONCURRENCY=4
SERPER_API_KEY=""
BRAVE_API_KEY=""
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""

# Robots-respecting same-host crawl budget for creator-owned websites.
WEBSITE_MAX_PAGES=6

# Optional commercial Instagram provider adapter.
# Leave as "none" to use public-meta + manual-input mode.
IG_PROVIDER="none"
IG_PROVIDER_URL=""
IG_PROVIDER_KEY=""
